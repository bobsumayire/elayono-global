{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elayono-global",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "elayono-content",
      "database_id": "3877bb9c-d05d-4af7-a3bd-d28c6440ddd4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "elayono-media"
    }
  ]
}
